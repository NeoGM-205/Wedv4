PORT=3000
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-rat-dai

# Local: để trống để dùng ./storage. Railway Volume: /app/storage
# STORAGE_DIR=/app/storage
NODE_ENV=production
PUBLIC_ORIGIN=https://your-domain.example
VAPID_SUBJECT=https://your-domain.example
AUTO_BACKUP_HOURS=6
BACKUP_KEEP=30

# Voice WebRTC
# STUN mặc định đã có. TURN rất nên dùng nếu thành viên ở mạng di động/NAT nghiêm ngặt.
# VOICE_STUN_URL=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=turn:turn.example.com:3478
# Khuyến nghị Coturn use-auth-secret để cấp credential tạm thời:
# WEBRTC_TURN_SECRET=shared-secret-cua-coturn
# WEBRTC_TURN_TTL_SECONDS=3600
# Hoặc credential tĩnh (đơn giản hơn, ít khuyến nghị):
# WEBRTC_TURN_USERNAME=giatoc
# WEBRTC_TURN_CREDENTIAL=doi-thanh-mat-khau-turn

# Voice: tự chuyển sang WebSocket Relay nếu WebRTC/STUN không nối được
VOICE_RELAY_FALLBACK=true
